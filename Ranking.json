    {
      "parameters": {
        "jsCode": "const usuarios = $input.all().map(i => i.json);\n\n// Simulamos montos aleatorios de donación para cada usuario\nconst ranking = usuarios.map(u => ({\n  userId: u.id,\n  nombre: u.name,\n  email: u.email,\n  total: Math.floor(Math.random() * 10000)\n}));\n\n// Ordenamos de mayor a menor\nranking.sort((a, b) => b.total - a.total);\n\n// Tomamos top 3\nconst top3 = ranking.slice(0, 3).map((u, idx) => ({\n  ...u,\n  rank: idx + 1\n}));\n\nreturn top3.map(u => ({ json: u }));"
      },
